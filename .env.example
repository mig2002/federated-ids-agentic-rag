# ==========================================
# API Keys Configuration
# ==========================================

# Groq API Key (for LLM reasoning & generation)
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (for web search fallback)
TAVILY_API_KEY=your_tavily_api_key_here

# Pinecone API Key (for vector database storage)
PINECONE_API_KEY=your_pinecone_api_key_here

# Hugging Face Token (optional: avoids rate limit warnings when downloading embeddings)
HF_TOKEN=your_huggingface_token_here

# ==========================================
# Optional Configuration Defaults
# ==========================================
GROQ_MODEL=openai/gpt-oss-20b
PINECONE_INDEX_NAME=agentic-rag-kb
PINECONE_NAMESPACE=langgraph-agentic-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PDF_DIR=pdf
